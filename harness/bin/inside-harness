#!/usr/bin/env python3
"""Install and verify the Sachkov Inside product harness."""

from __future__ import annotations

import argparse
import filecmp
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from urllib.parse import unquote


SCRIPT = Path(__file__).resolve()
WORKSPACE = SCRIPT.parents[2]
DEFAULT_PACKAGE = WORKSPACE / "harness/packages/inside-engineering"
DEFAULT_ADAPTERS = WORKSPACE / "harness/adapters"
STATE_REL = Path(".inside-harness/product-harness.json")
SNAPSHOT_REL = Path(".inside-harness/skills")
REGISTRY_REL = SNAPSHOT_REL / "REGISTRY.md"
INTEGRATIONS_REL = Path(".inside-harness/integrations.json")
PORTABLE_REL = Path(".agents/skills")
CLAUDE_SKILLS_REL = Path(".claude/skills")
DISCOVERY_LINKS = {
    PORTABLE_REL: "../.inside-harness/skills",
    CLAUDE_SKILLS_REL: "../.inside-harness/skills",
}
AGENTS_REL = Path("AGENTS.md")
CLAUDE_MD_REL = Path("CLAUDE.md")
PACKAGE_NAME = "inside-engineering"
AGENTS_START = "<!-- inside-product-harness:start -->"
AGENTS_END = "<!-- inside-product-harness:end -->"
ADR_FILENAME = re.compile(r"^(?P<number>[0-9]{4})-[a-z0-9]+(?:-[a-z0-9]+)*\.md$")
ADR_SUPERSEDED = re.compile(r"^superseded by ADR-(?P<number>[0-9]{4})$")
ADR_LIFECYCLE_STATUSES = {"proposed", "accepted", "deprecated"}
CODING_STANDARDS_POINTER = "For coding and review rules, read `CODING_STANDARDS.md`."
NATIVE_INTEGRATIONS = {
    Path(".codex/config.toml"): ("codex",),
    Path(".codex/hooks.json"): ("codex",),
    Path(".claude/settings.json"): ("claude",),
    Path(".cursor/hooks.json"): ("cursor",),
    Path(".mcp.json"): ("claude", "portable"),
}
MARKDOWN_LINK = re.compile(r"\[[^\]]*\]\((<[^>]+>|[^)\s]+)(?:\s+[^)]*)?\)")
MACHINE_LOCAL_PATH = re.compile(r"(?:/(?:Users|home|Applications)/|[A-Za-z]:\\\\)")
SECRET_ENVIRONMENT_NAME = re.compile(r"^[A-Z][A-Z0-9_]*$")


class HarnessError(RuntimeError):
    pass


def run(command: list[str], *, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, cwd=cwd, text=True, capture_output=True)
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise HarnessError(f"Command failed: {' '.join(command)}\n{detail}")
    return result


def repository_root(value: str) -> Path:
    candidate = Path(value).expanduser().resolve()
    result = run(["git", "-C", str(candidate), "rev-parse", "--show-toplevel"])
    return Path(result.stdout.strip()).resolve()


def load_manifest(package: Path) -> dict:
    path = package / "manifest.json"
    try:
        manifest = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HarnessError(f"Invalid package manifest {path}: {error}") from error
    expected = {"schemaVersion", "name", "version", "skills"}
    missing = expected - set(manifest)
    if missing:
        raise HarnessError(f"Package manifest misses: {', '.join(sorted(missing))}")
    if manifest["name"] != PACKAGE_NAME:
        raise HarnessError(f"Unsupported package name: {manifest['name']}")
    skills = manifest["skills"]
    if not isinstance(skills, list) or not skills or len(skills) != len(set(skills)):
        raise HarnessError("Package skills must be a non-empty unique list")
    profiles = manifest.get("skillProfiles")
    default_profile = manifest.get("defaultProfile")
    if profiles is None and default_profile is None:
        profiles = {"full": list(skills)}
        default_profile = "full"
        manifest["skillProfiles"] = profiles
        manifest["defaultProfile"] = default_profile
    if not isinstance(profiles, dict) or not profiles or default_profile not in profiles:
        raise HarnessError("Package must define skillProfiles and a valid defaultProfile")
    declared = set(skills)
    used: set[str] = set()
    for name, profile_skills in profiles.items():
        if not isinstance(name, str) or not name:
            raise HarnessError("Skill profile names must be non-empty strings")
        if (
            not isinstance(profile_skills, list)
            or not profile_skills
            or len(profile_skills) != len(set(profile_skills))
            or not set(profile_skills) <= declared
        ):
            raise HarnessError(f"Invalid skill profile: {name}")
        used.update(profile_skills)
    if used != declared:
        raise HarnessError("Every package skill must belong to at least one profile")
    return manifest


def read_frontmatter(skill_file: Path) -> dict[str, str]:
    text = skill_file.read_text()
    if not text.startswith("---\n"):
        raise HarnessError(f"Missing YAML frontmatter: {skill_file}")
    end = text.find("\n---", 4)
    if end < 0:
        raise HarnessError(f"Unclosed YAML frontmatter: {skill_file}")
    values: dict[str, str] = {}
    lines = text[4:end].splitlines()
    index = 0
    while index < len(lines):
        match = re.match(r"^([a-zA-Z0-9_-]+):\s*(.*?)\s*$", lines[index])
        if not match:
            index += 1
            continue
        key, value = match.groups()
        block_scalar = re.fullmatch(r"[|>](?:[1-9][+-]?|[+-][1-9]?)?", value)
        if value.startswith(("|", ">")) and not block_scalar:
            raise HarnessError(f"Unsupported YAML block scalar in {skill_file}: {value!r}")
        if block_scalar:
            block: list[str] = []
            index += 1
            while index < len(lines) and (not lines[index] or lines[index][0].isspace()):
                block.append(lines[index].strip())
                index += 1
            values[key] = " ".join(part for part in block if part)
            continue
        values[key] = value.strip().strip("\"")
        index += 1
    return values


def validated_skill_metadata(directory: Path) -> tuple[str, str, str]:
    metadata = read_frontmatter(directory / "SKILL.md")
    name = metadata.get("name")
    description = metadata.get("description")
    if name != directory.name or not description:
        raise HarnessError(f"Invalid project skill metadata: {directory}")
    disabled = metadata.get("disable-model-invocation", "false").lower()
    if disabled not in {"true", "false"}:
        raise HarnessError(f"Invalid disable-model-invocation value: {directory}")
    invocation = "User" if disabled == "true" else "Model"
    return name, description, invocation


def validate_package(package: Path, manifest: dict) -> None:
    skill_root = package / "skills"
    declared = set(manifest["skills"])
    present = {path.name for path in skill_root.iterdir() if path.is_dir()}
    if present != declared:
        raise HarnessError(
            f"Package skill directories differ from manifest: missing={sorted(declared - present)}, "
            f"extra={sorted(present - declared)}"
        )
    for path in package.rglob("*"):
        if path.is_symlink():
            raise HarnessError(f"Canonical package must not contain symlinks: {path}")
    managed_files = manifest.get("managedFiles", [])
    if not isinstance(managed_files, list):
        raise HarnessError("Package managedFiles must be a list")
    sources: set[Path] = set()
    targets: set[Path] = set()
    reserved_targets = {STATE_REL, AGENTS_REL, CLAUDE_MD_REL}
    for item in managed_files:
        if not isinstance(item, dict) or set(item) != {"source", "target"}:
            raise HarnessError("Each managed file must define only source and target")
        source = safe_relative_path(item["source"], "managed file source")
        target = safe_relative_path(item["target"], "managed file target")
        if source in sources or target in targets:
            raise HarnessError("Managed file sources and targets must be unique")
        if target in reserved_targets or target.parts[0] in {PORTABLE_REL.parts[0], CLAUDE_SKILLS_REL.parts[0]}:
            raise HarnessError(f"Managed file target conflicts with a reserved harness path: {target}")
        source_path = package / source
        if not source_path.is_file():
            raise HarnessError(f"Managed file source is missing or not a file: {source_path}")
        sources.add(source)
        targets.add(target)
    seen_names: set[str] = set()
    for name in manifest["skills"]:
        actual_name, _, _ = validated_skill_metadata(skill_root / name)
        if actual_name in seen_names:
            raise HarnessError(f"Duplicate skill name: {actual_name}")
        seen_names.add(actual_name)


def safe_relative_path(value: object, label: str) -> Path:
    if not isinstance(value, str) or not value.strip():
        raise HarnessError(f"Invalid {label}: {value!r}")
    path = Path(value)
    if path.is_absolute() or path == Path(".") or ".." in path.parts or path.parts[0] == ".git":
        raise HarnessError(f"Unsafe {label}: {value!r}")
    return path


def managed_files(manifest: dict) -> list[tuple[Path, Path]]:
    return [
        (
            safe_relative_path(item["source"], "managed file source"),
            safe_relative_path(item["target"], "managed file target"),
        )
        for item in manifest.get("managedFiles", [])
    ]


def profile_skills(manifest: dict, profile: str) -> list[str]:
    profiles = manifest["skillProfiles"]
    if profile not in profiles:
        raise HarnessError(
            f"Unknown skill profile {profile!r}; choose one of: {', '.join(sorted(profiles))}"
        )
    return profiles[profile]


def resolve_profile(manifest: dict, old_state: dict, requested: str | None) -> str:
    if requested is not None:
        profile_skills(manifest, requested)
        return requested
    stored = old_state.get("profile")
    if isinstance(stored, str):
        if stored not in manifest["skillProfiles"] and set(manifest["skillProfiles"]) == {"full"}:
            return "full"
        profile_skills(manifest, stored)
        return stored
    if old_state:
        raise HarnessError(
            "Installed state predates skill profiles; rerun with --profile core or --profile frontend"
        )
    return manifest["defaultProfile"]


def files(root: Path) -> dict[Path, Path]:
    if not root.exists():
        return {}
    return {path.relative_to(root): path for path in root.rglob("*") if path.is_file()}


def registry_content(root: Path) -> str:
    rows: list[tuple[str, str, str]] = []
    seen: set[str] = set()
    for directory in sorted(path for path in root.iterdir() if path.is_dir()):
        name, description, invocation = validated_skill_metadata(directory)
        if name in seen:
            raise HarnessError(f"Duplicate project skill name: {name}")
        seen.add(name)
        rows.append((name, invocation, description.replace("|", "\\|")))
    lines = [
        "# Project Skill Registry",
        "",
        "Fallback runtimes may route by intent only to `Model` skills. Open a `User` skill only",
        "when the user names it explicitly, then read only that skill's `SKILL.md`.",
        "",
        "| Skill | Invocation | Project path | When to use |",
        "|---|---|---|---|",
    ]
    lines.extend(
        f"| `{name}` | {invocation} | `.inside-harness/skills/{name}` | {description} |"
        for name, invocation, description in rows
    )
    return "\n".join(lines) + "\n"


def write_registry(repo: Path) -> None:
    path = repo / REGISTRY_REL
    path.write_text(registry_content(repo / SNAPSHOT_REL))


def ensure_discovery_links(repo: Path) -> None:
    for relative, target in DISCOVERY_LINKS.items():
        path = repo / relative
        if path.is_symlink() and os.readlink(path) == target:
            continue
        if path.exists() or path.is_symlink():
            raise HarnessError(f"Discovery path is not the managed link: {path}")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)


def migrate_legacy_roots(repo: Path, active_skills: list[str]) -> None:
    snapshot = repo / SNAPSHOT_REL
    managed = set(active_skills)
    local_sources: dict[str, Path] = {}
    legacy_roots: list[Path] = []
    for relative in DISCOVERY_LINKS:
        root = repo / relative
        if root.is_symlink() or not root.exists():
            continue
        if not root.is_dir():
            raise HarnessError(f"Legacy discovery path is not a directory: {root}")
        legacy_roots.append(root)
        for child in sorted(root.iterdir()):
            if not child.is_dir():
                raise HarnessError(f"Unexpected entry in legacy discovery root: {child}")
            if child.name in managed:
                continue
            previous = local_sources.get(child.name)
            if previous and tree_diff(previous, child):
                raise HarnessError(f"Conflicting project skill during migration: {child.name}")
            local_sources[child.name] = child

    for name, source in local_sources.items():
        target = snapshot / name
        if target.exists() and tree_diff(source, target):
            raise HarnessError(f"Conflicting project skill during migration: {name}")

    snapshot.mkdir(parents=True, exist_ok=True)
    for name, source in local_sources.items():
        target = snapshot / name
        if not target.exists():
            shutil.copytree(source, target)
    for root in legacy_roots:
        shutil.rmtree(root)
    ensure_discovery_links(repo)


def tree_diff(source: Path, target: Path) -> list[str]:
    left = files(source)
    right = files(target)
    changes: list[str] = []
    for rel in sorted(left.keys() | right.keys()):
        if rel not in right:
            changes.append(f"A {rel}")
        elif rel not in left:
            changes.append(f"D {rel}")
        elif not filecmp.cmp(left[rel], right[rel], shallow=False):
            changes.append(f"M {rel}")
    return changes


def exact_copy(source: Path, target: Path) -> None:
    if target.is_symlink():
        raise HarnessError(f"Refusing to replace symlink target: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=f".{target.name}-", dir=target.parent) as temp_value:
        staged = Path(temp_value) / target.name
        shutil.copytree(source, staged)
        if target.exists():
            shutil.rmtree(target)
        staged.rename(target)


def exact_file_copy(source: Path, target: Path) -> None:
    if target.is_symlink():
        raise HarnessError(f"Refusing to replace symlink target: {target}")
    if target.exists() and not target.is_file():
        raise HarnessError(f"Refusing to replace non-file target: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=f".{target.name}-", dir=target.parent) as temp_value:
        staged = Path(temp_value) / target.name
        shutil.copy2(source, staged)
        staged.replace(target)


def git_changes(repo: Path, paths: list[Path]) -> list[str]:
    args = ["git", "-C", str(repo), "status", "--porcelain", "--"]
    args.extend(str(path) for path in paths)
    result = run(args)
    return [line for line in result.stdout.splitlines() if line.strip()]


def load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise HarnessError(f"Invalid JSON file {path}: {error}") from error
    if not isinstance(value, dict):
        raise HarnessError(f"Expected a JSON object: {path}")
    return value


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    rendered = json.dumps(value, indent=2, ensure_ascii=False) + "\n"
    if path.exists() and path.read_text() == rendered:
        return
    path.write_text(rendered)


def replace_managed_block(path: Path, snippet: str, *, default_heading: str | None = None) -> None:
    content = path.read_text() if path.exists() else ""
    start = content.find(AGENTS_START)
    end = content.find(AGENTS_END)
    if (start >= 0) != (end >= 0):
        raise HarnessError(f"Incomplete product-harness block in {path}")
    if start >= 0:
        end += len(AGENTS_END)
        content = content[:start].rstrip() + "\n\n" + snippet.strip() + content[end:]
    else:
        if not content and default_heading:
            content = default_heading.rstrip() + "\n"
        content = content.rstrip() + "\n\n" + snippet.strip() + "\n"
    path.write_text(content.lstrip() if not default_heading else content)


def write_entrypoints(repo: Path, adapters: Path) -> None:
    agents_snippet = (adapters / "AGENTS.product.md").read_text()
    claude_snippet = (adapters / "CLAUDE.product.md").read_text()
    replace_managed_block(repo / AGENTS_REL, agents_snippet, default_heading=f"# {repo.name}\n")
    replace_managed_block(repo / CLAUDE_MD_REL, claude_snippet)


def state_value(manifest: dict, profile: str) -> dict:
    active_skills = profile_skills(manifest, profile)
    return {
        "schemaVersion": 3,
        "package": manifest["name"],
        "version": manifest["version"],
        "profile": profile,
        "managedSkills": active_skills,
        "snapshot": str(SNAPSHOT_REL),
        "managedFiles": [str(target) for _, target in managed_files(manifest)],
        "targets": {
            "portable": str(PORTABLE_REL),
            "claude": str(CLAUDE_SKILLS_REL),
        },
    }


def target_diffs(
    repo: Path,
    package: Path,
    manifest: dict,
    active_skills: list[str],
    obsolete_skills: set[str] | None = None,
) -> list[str]:
    changes: list[str] = []
    for name in active_skills:
        source = package / "skills" / name
        target = repo / SNAPSHOT_REL / name
        changes.extend(f"snapshot/{name}/{item}" for item in tree_diff(source, target))
    for name in sorted(obsolete_skills or set()):
        target = repo / SNAPSHOT_REL / name
        if target.exists() or target.is_symlink():
            changes.append(f"snapshot/{name}/D")
    for source_rel, target_rel in managed_files(manifest):
        source = package / source_rel
        target = repo / target_rel
        if not target.exists():
            changes.append(f"file/{target_rel}/A")
        elif target.is_symlink() or not target.is_file():
            changes.append(f"file/{target_rel}/M")
        elif not filecmp.cmp(source, target, shallow=False):
            changes.append(f"file/{target_rel}/M")
    return changes


def entrypoint_diffs(repo: Path, adapters: Path) -> list[str]:
    changes: list[str] = []
    for target_rel, source_name in (
        (AGENTS_REL, "AGENTS.product.md"),
        (CLAUDE_MD_REL, "CLAUDE.product.md"),
    ):
        target = repo / target_rel
        expected = (adapters / source_name).read_text().strip()
        if not target.exists():
            changes.append(f"entrypoint/{target_rel}/A")
        elif expected not in target.read_text():
            changes.append(f"entrypoint/{target_rel}/M")
    return changes


def installation_diffs(
    repo: Path,
    package: Path,
    manifest: dict,
    adapters: Path,
    active_skills: list[str],
    obsolete_skills: set[str] | None = None,
) -> list[str]:
    return target_diffs(repo, package, manifest, active_skills, obsolete_skills) + entrypoint_diffs(
        repo, adapters
    )


def managed_paths(repo: Path, manifest: dict, skill_names: set[str]) -> list[Path]:
    result = [STATE_REL, REGISTRY_REL, PORTABLE_REL, CLAUDE_SKILLS_REL, AGENTS_REL, CLAUDE_MD_REL]
    result.extend(SNAPSHOT_REL / name for name in sorted(skill_names))
    result.extend(target for _, target in managed_files(manifest))
    return result


def changes_add_only_new_content(changes: list[str], old_state: dict) -> bool:
    previous_skills = set(old_state.get("managedSkills", []))
    previous_files = set(old_state.get("managedFiles", []))
    for change in changes:
        parts = change.split("/")
        if parts[0] == "snapshot":
            if len(parts) < 3 or parts[1] in previous_skills or not parts[2].startswith("A "):
                return False
        elif parts[0] == "file":
            target = "/".join(parts[1:-1])
            if parts[-1] != "A" or target in previous_files:
                return False
        else:
            return False
    return bool(changes)


def install_or_update(
    repo: Path,
    package: Path,
    adapters: Path,
    *,
    adopt_existing: bool = False,
    initial_only: bool = False,
    requested_profile: str | None = None,
) -> None:
    manifest = load_manifest(package)
    validate_package(package, manifest)
    state_path = repo / STATE_REL
    old_state = load_json(state_path)
    profile = resolve_profile(manifest, old_state, requested_profile)
    active_skills = profile_skills(manifest, profile)
    obsolete_skills = set(old_state.get("managedSkills", [])) - set(active_skills)
    if initial_only and old_state:
        print(f"Already installed in {repo}; checking for an idempotent update.")
    if old_state and old_state.get("package") != manifest["name"]:
        raise HarnessError(f"Another harness package owns {state_path}")
    conflicts: list[str] = []
    if not old_state:
        for name in active_skills:
            for candidate in (repo / SNAPSHOT_REL / name, repo / PORTABLE_REL / name, repo / CLAUDE_SKILLS_REL / name):
                if candidate.exists() or candidate.is_symlink():
                    conflicts.append(str(candidate.relative_to(repo)))
        for source_rel, target_rel in managed_files(manifest):
            source = package / source_rel
            target = repo / target_rel
            if target.exists() or target.is_symlink():
                identical = target.is_file() and not target.is_symlink() and filecmp.cmp(
                    source, target, shallow=False
                )
                if not identical:
                    conflicts.append(str(target_rel))
        if conflicts and not adopt_existing:
            rendered = "\n  - ".join(conflicts)
            raise HarnessError(
                "Existing skills conflict with the managed package:\n  - "
                + rendered
                + "\nRe-run install with --adopt-existing only after reviewing these directories."
            )

    migrated = False
    if old_state and old_state.get("schemaVersion") == 1:
        dirty = git_changes(
            repo,
            managed_paths(repo, manifest, set(active_skills) | obsolete_skills),
        )
        if dirty:
            raise HarnessError(
                "Legacy managed files have uncommitted changes; refusing to migrate:\n"
                + "\n".join(dirty)
            )
        migrate_legacy_roots(repo, active_skills)
        migrated = True
    elif not old_state and (
        adopt_existing
        or any((repo / relative).is_dir() and not (repo / relative).is_symlink() for relative in DISCOVERY_LINKS)
    ):
        migrate_legacy_roots(repo, active_skills)
        migrated = True
    else:
        ensure_discovery_links(repo)

    changes = installation_diffs(
        repo,
        package,
        manifest,
        adapters,
        active_skills,
        obsolete_skills,
    )
    if old_state and changes and not migrated:
        additions_only = changes_add_only_new_content(changes, old_state)
        dirty = (
            git_changes(
                repo,
                managed_paths(repo, manifest, set(active_skills) | obsolete_skills),
            )
            if not additions_only
            else []
        )
        if dirty:
            raise HarnessError(
                "Managed files differ from the package and have uncommitted changes; refusing to overwrite:\n"
                + "\n".join(dirty)
            )

    for name in active_skills:
        source = package / "skills" / name
        target = repo / SNAPSHOT_REL / name
        if tree_diff(source, target):
            exact_copy(source, target)

    for name in sorted(obsolete_skills):
        target = repo / SNAPSHOT_REL / name
        if target.is_symlink() or (target.exists() and not target.is_dir()):
            raise HarnessError(f"Refusing to remove invalid obsolete skill path: {target}")
        if target.exists():
            shutil.rmtree(target)

    for source_rel, target_rel in managed_files(manifest):
        source = package / source_rel
        target = repo / target_rel
        if (
            not target.exists()
            or target.is_symlink()
            or not target.is_file()
            or not filecmp.cmp(source, target, shallow=False)
        ):
            exact_file_copy(source, target)

    write_registry(repo)
    write_entrypoints(repo, adapters)
    write_json(state_path, state_value(manifest, profile))
    action = "Installed" if not old_state else "Updated"
    print(f"{action} {manifest['name']} {manifest['version']} ({profile}) in {repo}")


def diff_command(
    repo: Path,
    package: Path,
    adapters: Path,
    requested_profile: str | None = None,
) -> int:
    manifest = load_manifest(package)
    validate_package(package, manifest)
    old_state = load_json(repo / STATE_REL)
    profile = resolve_profile(manifest, old_state, requested_profile)
    active_skills = profile_skills(manifest, profile)
    obsolete_skills = set(old_state.get("managedSkills", [])) - set(active_skills)
    changes = installation_diffs(
        repo,
        package,
        manifest,
        adapters,
        active_skills,
        obsolete_skills,
    )
    if changes:
        print("\n".join(changes))
        return 1
    print(f"No managed harness drift in {repo}")
    return 0


def require_managed_block(path: Path, expected: str) -> None:
    if not path.exists():
        raise HarnessError(f"Missing entrypoint: {path}")
    content = path.read_text()
    if expected.strip() not in content:
        raise HarnessError(f"Managed entrypoint block differs: {path}")


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def local_markdown_targets(path: Path, repo: Path) -> list[tuple[str, Path]]:
    targets: list[tuple[str, Path]] = []
    content = re.sub(r"```.*?```", "", path.read_text(), flags=re.DOTALL)
    for raw_target in MARKDOWN_LINK.findall(content):
        target = raw_target.strip("<>")
        target = unquote(target.split("#", 1)[0].split("?", 1)[0])
        if (
            not target
            or target.startswith(("#", "/"))
            or re.match(r"^[a-z][a-z\d+.-]*:", target, re.IGNORECASE)
        ):
            continue
        resolved = (path.parent / target).resolve()
        try:
            resolved.relative_to(repo)
        except ValueError as error:
            raise HarnessError(
                f"Agent documentation pointer escapes repository: "
                f"{path.relative_to(repo)} -> {target}"
            ) from error
        targets.append((target, resolved))
    return targets


def base_agent_documents(repo: Path) -> set[Path]:
    result = {
        repo / relative
        for relative in (
            AGENTS_REL,
            CLAUDE_MD_REL,
            Path("WORKFLOW.md"),
            Path("CODING_STANDARDS.md"),
            Path("CONTEXT.md"),
        )
        if (repo / relative).is_file()
    }
    for root in (repo / "docs/agents", repo / "apps"):
        if not root.exists():
            continue
        result.update(
            path
            for path in root.rglob("*.md")
            if path.name in {"AGENTS.md", "CLAUDE.md", "CODING_STANDARDS.md"}
            or root == repo / "docs/agents"
        )
    snapshot = repo / SNAPSHOT_REL
    if snapshot.exists():
        result.update(path for path in snapshot.glob("*/SKILL.md") if path.is_file())
    return result


def validate_agent_documents(repo: Path) -> None:
    base = base_agent_documents(repo)
    documents = set(base)
    failures: list[str] = []
    for path in sorted(base):
        for target, resolved in local_markdown_targets(path, repo):
            if not resolved.exists():
                failures.append(f"{path.relative_to(repo)}: local pointer does not resolve: {target}")
            elif resolved.is_file() and resolved.suffix.lower() == ".md":
                documents.add(resolved)

    for path in sorted(documents):
        content = path.read_text()
        if MACHINE_LOCAL_PATH.search(content):
            failures.append(f"{path.relative_to(repo)}: machine-local path is not portable")
        for target, resolved in local_markdown_targets(path, repo):
            if not resolved.exists():
                failures.append(f"{path.relative_to(repo)}: local pointer does not resolve: {target}")

    if failures:
        raise HarnessError("Agent documentation is not portable:\n" + "\n".join(sorted(set(failures))))


def validate_integration_inventory(repo: Path) -> None:
    discovered = {path for path in NATIVE_INTEGRATIONS if (repo / path).is_file()}
    inventory_path = repo / INTEGRATIONS_REL
    if not discovered and not inventory_path.exists():
        return
    inventory = load_json(inventory_path)
    if inventory.get("schemaVersion") != 1 or not isinstance(inventory.get("integrations"), list):
        raise HarnessError(f"Invalid integration inventory: {inventory_path}")

    entries: dict[Path, dict] = {}
    for entry in inventory["integrations"]:
        if not isinstance(entry, dict):
            raise HarnessError(f"Invalid integration inventory entry: {entry!r}")
        path = safe_relative_path(entry.get("path"), "integration path")
        if path in entries:
            raise HarnessError(f"Duplicate integration inventory path: {path}")
        entries[path] = entry

    if set(entries) != discovered:
        raise HarnessError(
            "Integration inventory differs from native project configs: "
            f"missing={sorted(str(path) for path in discovered - set(entries))}, "
            f"extra={sorted(str(path) for path in set(entries) - discovered)}"
        )

    for path, entry in entries.items():
        runtimes = entry.get("runtimes")
        verification = entry.get("verification")
        secrets = entry.get("secretEnvironmentVariables")
        digest = entry.get("sha256")
        if not isinstance(runtimes, list) or not runtimes or not all(
            isinstance(value, str) and value for value in runtimes
        ):
            raise HarnessError(f"Integration runtimes must be a non-empty list: {path}")
        expected_runtimes = list(NATIVE_INTEGRATIONS.get(path, ()))
        if runtimes != expected_runtimes:
            raise HarnessError(
                f"Integration runtimes differ for {path}: "
                f"expected={expected_runtimes}, actual={runtimes}"
            )
        if not isinstance(verification, str) or not verification.strip():
            raise HarnessError(f"Integration verification is required: {path}")
        if not isinstance(secrets, list) or not all(
            isinstance(value, str) and SECRET_ENVIRONMENT_NAME.fullmatch(value) for value in secrets
        ):
            raise HarnessError(f"Invalid secret environment-variable names: {path}")
        target = repo / path
        if not isinstance(digest, str) or digest != sha256(target):
            raise HarnessError(f"Integration hash differs: {path}")


def validate_repository_architecture(repo: Path) -> None:
    standards = repo / "CODING_STANDARDS.md"
    agents = repo / AGENTS_REL
    if standards.exists() and not standards.is_file():
        raise HarnessError(f"Coding standards path is not a file: {standards}")
    if standards.is_file() and (
        not agents.is_file() or CODING_STANDARDS_POINTER not in agents.read_text()
    ):
        raise HarnessError(
            "AGENTS.md must include the coding-standards context pointer: "
            f"{CODING_STANDARDS_POINTER}"
        )

    validate_agent_documents(repo)
    validate_integration_inventory(repo)

    adr_root = repo / "docs/adr"
    if not adr_root.exists():
        return
    if not adr_root.is_dir():
        raise HarnessError(f"ADR path is not a directory: {adr_root}")

    adrs: dict[str, tuple[Path, str]] = {}
    for path in sorted(adr_root.glob("*.md")):
        match = ADR_FILENAME.fullmatch(path.name)
        if match is None:
            raise HarnessError(f"ADR filename must be NNNN-lowercase-slug.md: {path}")
        try:
            status = read_frontmatter(path).get("status")
        except HarnessError as error:
            raise HarnessError(f"ADR must declare a lifecycle status: {path}") from error
        if status is None:
            raise HarnessError(f"ADR must declare a lifecycle status: {path}")
        if status not in ADR_LIFECYCLE_STATUSES and ADR_SUPERSEDED.fullmatch(status) is None:
            raise HarnessError(f"Unsupported ADR lifecycle status {status!r}: {path}")
        number = match.group("number")
        if number in adrs:
            raise HarnessError(f"Duplicate ADR-{number}: {adrs[number][0]}, {path}")
        adrs[number] = (path, status)

    for number, (path, status) in adrs.items():
        superseded = ADR_SUPERSEDED.fullmatch(status)
        if superseded is None:
            continue
        replacement = superseded.group("number")
        if replacement not in adrs:
            raise HarnessError(
                f"{path} references missing ADR-{replacement}"
            )
        if int(replacement) <= int(number):
            raise HarnessError(f"{path} must be superseded by a later ADR number")

def health_command(repo: Path, package: Path, adapters: Path) -> None:
    manifest = load_manifest(package)
    validate_package(package, manifest)
    state = load_json(repo / STATE_REL)
    profile = resolve_profile(manifest, state, None)
    active_skills = profile_skills(manifest, profile)
    if state != state_value(manifest, profile):
        raise HarnessError(f"Installed state differs from package: {repo / STATE_REL}")
    changes = target_diffs(repo, package, manifest, active_skills)
    if changes:
        raise HarnessError("Managed harness drift detected:\n" + "\n".join(changes))
    for relative, target in DISCOVERY_LINKS.items():
        path = repo / relative
        if not path.is_symlink() or os.readlink(path) != target:
            raise HarnessError(f"Broken discovery link: {relative} -> {target}")
    expected_registry = registry_content(repo / SNAPSHOT_REL)
    registry = repo / REGISTRY_REL
    if not registry.is_file() or registry.read_text() != expected_registry:
        raise HarnessError(f"Project skill registry differs: {registry}")

    require_managed_block(repo / AGENTS_REL, (adapters / "AGENTS.product.md").read_text())
    require_managed_block(repo / CLAUDE_MD_REL, (adapters / "CLAUDE.product.md").read_text())
    validate_repository_architecture(repo)
    print(
        f"Healthy: {manifest['name']} {manifest['version']} ({profile}) in {repo}\n"
        f"  Snapshot: {SNAPSHOT_REL}\n"
        f"  Discovery: {PORTABLE_REL}, {CLAUDE_SKILLS_REL}\n"
        f"  Skills: {len(active_skills)} managed"
    )


def rollback_command(repo: Path, git_ref: str, requested_profile: str | None = None) -> None:
    with tempfile.TemporaryDirectory(prefix="inside-harness-rollback-") as temp_value:
        archive = Path(temp_value) / "harness.tar"
        result = run(
            [
                "git",
                "-C",
                str(WORKSPACE),
                "archive",
                "--format=tar",
                "--output",
                str(archive),
                git_ref,
                "harness/packages/inside-engineering",
                "harness/adapters",
            ],
            check=False,
        )
        if result.returncode != 0:
            raise HarnessError(
                f"Cannot read product harness from Workspace ref {git_ref!r}: "
                f"{result.stderr.strip() or result.stdout.strip()}"
            )
        extracted = Path(temp_value) / "source"
        extracted.mkdir()
        with tarfile.open(archive) as bundle:
            bundle.extractall(extracted, filter="data")
        package = extracted / "harness/packages/inside-engineering"
        adapters = extracted / "harness/adapters"
        install_or_update(repo, package, adapters, requested_profile=requested_profile)
        print(f"Rolled back using Workspace ref {git_ref}")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    subcommands = result.add_subparsers(dest="command", required=True)
    install = subcommands.add_parser("install", help="Install the current product harness")
    install.add_argument("repository")
    install.add_argument("--adopt-existing", action="store_true")
    install.add_argument("--profile")
    for name, help_text in (
        ("update", "Update managed files to the current package"),
        ("diff", "Compare installed skills with the current package"),
        ("health", "Validate package, installation, and runtime adapters"),
    ):
        command = subcommands.add_parser(name, help=help_text)
        command.add_argument("repository")
        if name in {"update", "diff"}:
            command.add_argument("--profile")
    rollback = subcommands.add_parser("rollback", help="Install a package from an older Workspace ref")
    rollback.add_argument("repository")
    rollback.add_argument("--to", required=True, dest="git_ref")
    rollback.add_argument("--profile")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        repo = repository_root(args.repository)
        if args.command == "install":
            install_or_update(
                repo,
                DEFAULT_PACKAGE,
                DEFAULT_ADAPTERS,
                adopt_existing=args.adopt_existing,
                initial_only=True,
                requested_profile=args.profile,
            )
        elif args.command == "update":
            install_or_update(
                repo,
                DEFAULT_PACKAGE,
                DEFAULT_ADAPTERS,
                requested_profile=args.profile,
            )
        elif args.command == "diff":
            return diff_command(
                repo,
                DEFAULT_PACKAGE,
                DEFAULT_ADAPTERS,
                requested_profile=args.profile,
            )
        elif args.command == "health":
            health_command(repo, DEFAULT_PACKAGE, DEFAULT_ADAPTERS)
        elif args.command == "rollback":
            rollback_command(repo, args.git_ref, args.profile)
        return 0
    except HarnessError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
