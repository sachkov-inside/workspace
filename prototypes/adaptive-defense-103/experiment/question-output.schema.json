{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "questions"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "inside.adaptive-defense-questions.v1"
    },
    "attemptId": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "groundedIn", "dimension", "whyAsked"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "groundedIn": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dimension": {
          "type": "string",
          "enum": ["correctness", "reliability", "operability", "decision_quality"]
        },
        "whyAsked": { "type": "string", "minLength": 1 }
      }
    }
  }
}
