{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inside.sachkov.dev/contracts/evaluation-report.v1.schema.json",
  "title": "Inside local evaluation report v1 prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "case",
    "variantId",
    "evaluator",
    "assignment",
    "source",
    "execution",
    "scenarios",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": "inside.evaluation-report.v1" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "variantId": { "type": "string", "minLength": 1 },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "language"],
      "properties": {
        "id": { "const": "inside-local-evaluator" },
        "version": { "const": "0.1.0-prototype" },
        "language": { "enum": ["go", "typescript"] }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repositoryId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "startedAt", "finishedAt", "environment"],
      "properties": {
        "method": { "const": "local" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "dockerServer", "dockerCompose"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 },
            "dockerServer": { "type": "string", "minLength": 1 },
            "dockerCompose": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "durationMs", "diagnostic"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "diagnostic": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verdict": { "enum": ["passed", "failed"] }
  }
}
