{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inside.sachkov.dev/contracts/case-spec.v1.schema.json",
  "title": "Inside CaseSpec v1 prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "case",
    "variants",
    "publicScenario",
    "integration",
    "reliabilityEnvelope",
    "loadProfile"
  ],
  "properties": {
    "schemaVersion": { "const": "inside.case-spec.v1" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runtime", "framework", "database"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "minLength": 1 },
          "framework": { "type": "string", "minLength": 1 },
          "database": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publicScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "orderAcceptanceMaxMs", "partnerResponses", "deliveryDeadlineMs"],
      "properties": {
        "id": { "const": "temporary-partner-failure" },
        "orderAcceptanceMaxMs": { "type": "integer", "minimum": 1 },
        "partnerResponses": {
          "type": "array",
          "prefixItems": [{ "const": 503 }, { "const": 204 }],
          "items": false
        },
        "deliveryDeadlineMs": { "type": "integer", "minimum": 1 }
      }
    },
    "integration": { "type": "object" },
    "reliabilityEnvelope": { "type": "object" },
    "loadProfile": { "type": "object" }
  }
}
